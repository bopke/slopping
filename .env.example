# --- Shardfall server configuration (copy to .env) ---

# Nickname(s) with admin rights (comma separated, case-insensitive).
ADMIN_NICK=bopke
# Password for the first admin nick; set on every start. SET THIS, otherwise
# whoever registers the admin nickname first owns the admin account.
ADMIN_PASSWORD=change-me-please

# Origins allowed to open the websocket (your Cloudflare Pages URL). "*" = any.
ALLOWED_ORIGINS=https://shardfall.pages.dev

# Only for `--profile tls`: public hostname pointing at this machine.
DOMAIN=game.example.com
# Host port for plain ws (used when you bring your own reverse proxy).
SERVER_PORT=8080
